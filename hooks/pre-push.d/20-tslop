#!/usr/bin/env bash
# tslop — last gate before anything leaves the machine.
#
# pre-commit and commit-msg are per-commit at CREATION time. A history can reach
# push without ever passing them: amended or reworded commits, an interactive
# rebase, cherry-picks and merges from elsewhere, a clone where core.hooksPath
# was never set, or plain `--no-verify`. This re-checks the outgoing range so
# the weakest path into the history is still covered.
#
# Git delivers <local-ref> <local-sha> <remote-ref> <remote-sha> on stdin.
#
#   TSLOP_PUSH_FAIL_ON   suspect | slop | never  (default: slop)
#   TSLOP_PUSH_FORENSIC  0 to stop gating on forensic findings (default: 1)
#   TSLOP_PUSH_MAX       commits to check for a new branch or tag (default: 200)
set -euo pipefail

TSLOP_BIN="${TSLOP_BIN:-tslop}"
ZERO="0000000000000000000000000000000000000000"
REMOTE_NAME="${1:-origin}"

if ! command -v "$TSLOP_BIN" >/dev/null 2>&1 && [ ! -x "$TSLOP_BIN" ]; then
  echo "tslop: '$TSLOP_BIN' not found on PATH; skipping." >&2
  exit 0
fi

fail_args=(--fail-on "${TSLOP_PUSH_FAIL_ON:-slop}")
[ "${TSLOP_PUSH_FORENSIC:-1}" = "1" ] && fail_args+=(--fail-on-forensic)

worst=0
record() {
  local rc="$1"
  [ "$rc" = "4" ] && rc=0               # degraded coverage is advisory
  [ "$rc" -gt "$worst" ] && worst=$rc
  return 0
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion adds nothing

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch or tag: check exactly the commits that no ref on this remote
    # already carries. A single merge-base cannot bound that set when the tip
    # merges history from several remote refs, so list the outgoing commits and
    # check each one. With no local knowledge of the remote, the list is the
    # tip's own history, capped by TSLOP_PUSH_MAX.
    outgoing="$(git rev-list --max-count="${TSLOP_PUSH_MAX:-200}" "$local_sha" --not --remotes="$REMOTE_NAME" </dev/null)"
    for commit in $outgoing; do
      set +e
      "$TSLOP_BIN" check --commits "$commit" --max-commits 1 "${fail_args[@]}" </dev/null
      rc=$?
      set -e
      record "$rc"
    done
    continue
  fi

  set +e
  "$TSLOP_BIN" check --commits "$remote_sha..$local_sha" "${fail_args[@]}" </dev/null
  rc=$?
  set -e
  record "$rc"
done

if [ "$worst" = "1" ]; then
  echo "tslop: BLOCKED — an outgoing commit message carries assistant context or filler." >&2
  echo "  reword with 'git rebase -i'; bypass with TSLOP_SKIP=1" >&2
fi
exit "$worst"
